#!/bin/sh
# CourtConnect offline ISO — init script (runs as PID 1)
# Boots minimal Linux, serves the site at http://localhost:8080

mount -t proc none /proc 2>/dev/null
mount -t sysfs none /sys 2>/dev/null
mount -t devtmpfs devtmpfs /dev 2>/dev/null

hostname courtconnect

echo ""
echo "=============================================="
echo "  CourtConnect — offline legal services hub"
echo "  Website:  http://localhost:8080"
echo "  (In the browser of this machine)"
echo "=============================================="
echo ""

# Start the web server (busybox httpd serves /www)
/bin/busybox httpd -p 8080 -h /www -f >/dev/null 2>&1 &
HTTPD_PID=$!

sleep 2
if kill -0 $HTTPD_PID 2>/dev/null; then
  echo "Web server running (pid $HTTPD_PID)."
else
  echo "WARNING: web server failed to start; dropping to shell."
fi

echo "Press Ctrl-Alt-F1 or type 'poweroff' to shut down."
# keep the system alive
while true; do
  sleep 3600
done
