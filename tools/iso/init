#!/bin/sh
# CourtConnect offline ISO — init script (PID 1)
# Minimal kiosk: serves the site at http://localhost:8080

export PATH=/bin:/usr/bin:/sbin:/usr/sbin

/bin/busybox mount -t proc none /proc 2>/dev/null
/bin/busybox mount -t sysfs none /sys 2>/dev/null
/bin/busybox mount -t devtmpfs devtmpfs /dev 2>/dev/null

/bin/busybox hostname courtconnect

echo ""
echo "=============================================="
echo "  CourtConnect — offline legal services hub"
echo "  Website:  http://localhost:8080"
echo "=============================================="
echo ""

/bin/busybox httpd -p 8080 -h /www -f >/dev/null 2>&1 &
HTTPD_PID=$!

/bin/busybox sleep 2
if /bin/busybox kill -0 $HTTPD_PID 2>/dev/null; then
  echo "Web server running (pid $HTTPD_PID)."
else
  echo "WARNING: web server failed to start; dropping to shell."
fi

echo "Type 'poweroff' to shut down."
while true; do
  /bin/busybox sleep 3600
done
